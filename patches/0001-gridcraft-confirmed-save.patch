+                .is_some_and(|ed| ed.doc == doc_uid && ed.original.as_deref() != Some(ed.text.as_str()));
+            let text_box_draft = app.text_box_editor.is_some() && active_uid == Some(doc_uid);
+            base_dirty || cell_draft_changed || text_box_draft
+        };
+        let any_dirty = app
+            .session
+            .documents()
+            .iter()
